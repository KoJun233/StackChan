POSTGRES_PASSWORD=
COMPANION_DEVICE_TOKEN_SECRET=
COMPANION_SECRETS_ENCRYPTION_KEY=
COMPANION_ADMIN_INITIAL_PASSWORD=
# 可选：发布时填写任务提交短哈希，健康中心会显示该运行版本。
COMPANION_BUILD_VERSION=0.0.1-SNAPSHOT
# 可选：默认 Skill ZIP 上限为 4 MiB，解压后总量上限为 16 MiB。
COMPANION_AGENT_MAX_SKILL_ARCHIVE_BYTES=4194304
COMPANION_AGENT_MAX_SKILL_UNCOMPRESSED_BYTES=16777216
# 可选：仅持续委托公开资料/Bark 使用固定公网 DoH；默认仍用系统 DNS。
STACKCHAN_RESEARCH_PUBLIC_DNS_OVER_HTTPS=false
# PostgreSQL 逻辑备份默认启动即执行，之后每 24 小时执行一次。
POSTGRES_BACKUP_RUN_ON_START=true
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
