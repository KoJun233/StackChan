CONFIG_IDF_TARGET="esp32s3"
# Fit the local face detector and complete CJK font in the unchanged OTA slots.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9L_HISTACKCHAN_TTS3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_ESP_LV_EAF_ENABLE_SW_JPEG=n
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_DEF_REFR_PERIOD=5
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=24
CONFIG_BSP_LCD_DRAW_BUF_DOUBLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# DEVICE-008: local tracking starts disabled; only a menu gesture opens its runtime gate.
# Keep GC0308 on QVGA RGB565BE rather than allocating the default VGA frame buffers.
CONFIG_CAMERA_GC0308=y
CONFIG_CAMERA_GC0308_DVP_RGB565_BE_320X240_20FPS=y
CONFIG_CAMERA_GC0308_DVP_DEFAULT_FMT_RGB565_BE_320X240_20FPS=y
CONFIG_CAMERA_GC0308_DVP_YUV422_YUYV_640X480_16FPS=n
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_FLASH_ESPDET_PICO_224_224_FACE=n
CONFIG_FLASH_ESPDET_PICO_416_416_FACE=n
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y

# GC0308 supplies RGB565BE; both face graphs consume quantized RGB888.
# Keep only that ESP-DL conversion family inside the original 3 MiB OTA slot.
CONFIG_PIX_CVT_RGB565_TO_RGB888_SUPPORT=y
CONFIG_PIX_CVT_RGB565_TO_RGB565_SUPPORT=n
CONFIG_PIX_CVT_RGB565_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_RGB565_TO_HSV_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_RGB888_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_RGB565_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_HSV_SUPPORT=n
CONFIG_PIX_CVT_GRAY_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_HSV_TO_HSV_MASK_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_RGB888_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_RGB565_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_HSV_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_YUV_SUPPORT=n
